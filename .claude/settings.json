{
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git diff-tree *)",
      "Bash(git rm *)",
      "Bash(git revert *)",
      "Bash(node -c *)",
      "Bash(python scripts/*)",
      "Bash(node scripts/*)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  }
}
