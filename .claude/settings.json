{
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git diff-tree *)",
      "Bash(git rm *)",
      "Bash(git revert *)",
      "Bash(node -c *)",
      "Bash(python scripts/*)",
      "Bash(node scripts/*)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/inicio-da-sessao.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/rules-local/sessao.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\gelva\\AppData\\Local\\Programs\\ai-memory\\ai-memory.exe\" --data-dir \"C:\\Users\\gelva\\AppData\\Local\\ai-memory\" hook --event session-start --agent claude-code --server-url \"http://127.0.0.1:49374\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*([Bb]rowser|chrome|computer).*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/antes-da-ferramenta.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/depois-de-gravar.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\gelva\\AppData\\Local\\Programs\\ai-memory\\ai-memory.exe\" --data-dir \"C:\\Users\\gelva\\AppData\\Local\\ai-memory\" hook --event post-tool-use --agent claude-code --server-url \"http://127.0.0.1:49374\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/rules-local/jev/ganchos/claude-prompt.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
