# Chave da Claude API (https://console.anthropic.com) — opcional, sem ela não há resumos/IA
ANTHROPIC_API_KEY=
# Token de acesso ao dashboard (gere um valor longo e aleatório)
DASHBOARD_TOKEN=
# Servidor (somente local)
HOST_SERVIDOR=127.0.0.1
PORTA_SERVIDOR=3210
# Seu número com DDI e DDD, só dígitos (ex.: 5549999999999)
MEU_NUMERO=
# Fuso horário usado nos resumos e no agendador
FUSO_HORARIO=America/Sao_Paulo
# Nível de log: trace | debug | info | warn | error
NIVEL_LOG=info
