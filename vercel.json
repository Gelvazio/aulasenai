{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "PREV=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git rev-parse -q --verify \"$PREV^{commit}\" >/dev/null 2>&1 || PREV=HEAD^; git diff --quiet \"$PREV\" HEAD -- . ':(exclude)tasks/' ':(exclude)rules-local/'; test $? -eq 0",
  "headers": [
    {
      "source": "/(.*)\\.(js|mjs|css|woff|woff2|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
